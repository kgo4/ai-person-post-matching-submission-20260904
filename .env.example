# ============================================
# 环境变量模板 — 复制为 .env 后填入实际值
# cp .env.example .env
# ============================================

# MySQL
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_password_here
MYSQL_DATABASE=hrms_db
MYSQL_PORT=3306

# Redis
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# 前端端口
FRONTEND_PORT=80

# ===== 外部服务密钥 =====

# DeepSeek (AI 对话)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 对支持 thinking 参数的推理模型禁用隐藏推理输出，避免结构化响应为空。
# 仅在已验证提供商支持时设为 true。
AI_THINKING_DISABLED=false

# 阿里云 DashScope (向量嵌入)
DASHSCOPE_API_KEY=sk-your-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Milvus 向量数据库（自建 Standalone，随 docker-compose 启动）
# 容器内（backend）访问：http://milvus:19530
# 宿主机/本地 IDE 直连调试：http://localhost:19530
MILVUS_URI=http://milvus:19530
# 自建 Milvus 默认无鉴权，token 留空即可（仅 Zilliz Cloud 需要 token）
MILVUS_TOKEN=
# Milvus 默认数据库名是 default（Zilliz Cloud 上是实例内自定义的库名）
MILVUS_DATABASE=default
# 如需临时切回 Zilliz Cloud，改回下面三行：
# MILVUS_URI=https://your-instance.zilliz.com
# MILVUS_TOKEN=your-token-here
# MILVUS_DATABASE=your-database-name

# 火山引擎语音服务
VOLCENGINE_SPEECH_APP_ID=your-app-id
VOLCENGINE_SPEECH_ACCESS_TOKEN=your-token

# 火山引擎实时对话
VOLCENGINE_REALTIME_ACCESS_KEY=your-access-key
VOLCENGINE_REALTIME_APP_KEY=your-app-key

# ===== 独立爬虫系统（全部可选；不部署爬虫时保持默认即可） =====
# 主系统校验爬虫推送的 X-Crawler-Key。留空则爬虫内部接口一律拒绝(401)，
# 但不会影响主系统启动，也不影响既有岗位 JD 解析链路。与爬虫侧 MAIN_SYSTEM_TOKEN 同值。
MARKET_JD_CRAWLER_API_KEY=
# 是否强制 HMAC 签名（X-Crawler-Timestamp + X-Crawler-Signature，文档 §7.7）
MARKET_JD_CRAWLER_SIGNATURE_ENABLED=false
MARKET_JD_CRAWLER_SHARED_SECRET=
# 请求体上限（字节）与单批条数上限
MARKET_JD_CRAWLER_MAX_BODY_BYTES=10485760
MARKET_JD_CRAWLER_MAX_ITEMS=100
# 推送入库后是否自动触发解析（爬虫数据「入池即可用」的关键开关）
MARKET_JD_CRAWLER_AUTO_ANALYZE_ENABLED=true
# 采集命令有效期（秒）与爬虫在线判定阈值（秒）
MARKET_JD_CRAWLER_COMMAND_EXPIRE_SECONDS=1800
MARKET_JD_CRAWLER_AGENT_ONLINE_THRESHOLD_SECONDS=90

# 【已下线，仅过渡兼容】反向代理开关：默认 false。
# false 时 /api/post/evolution/crawler/trigger|task/{id} 返回 410，采集走「采集命令 + 本地轮询」。
# 仅在本地爬虫尚未实现轮询时临时置 true（会使主系统反向访问本地地址，违反上游验收项 6）。
CRAWLER_SYSTEM_ENABLED=false
CRAWLER_SYSTEM_LEGACY_PROXY_ENABLED=false
# 爬虫系统地址，如 http://127.0.0.1:8081 或 http://crawler-host:8081
CRAWLER_SYSTEM_URL=
# 调用爬虫系统时附带的 X-Crawler-Api-Token（爬虫侧当前未强制校验，可留空）
CRAWLER_SYSTEM_TOKEN=

# ===== 邮件通道（视频终面邀请通知；全部可留空） =====
# 走 QQ 邮箱 SMTP 发邀请邮件；留空时应用照常启动，只是邀请邮件会被标记为「已跳过」，
# 站内通知与终面流程完全不受影响。
#
# ⚠️ MAIL_PASSWORD 填的是 QQ 邮箱后台「设置 → 账号与安全 → 授权码管理」生成的**授权码**，
#    不是 QQ 登录密码；修改 QQ 密码会导致授权码失效，需重新生成。
# IMAP/SMTP 设置：用户名/账户 = QQ 邮箱完整地址；发送服务器 smtp.qq.com，SSL 端口 465（也支持 587）。
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
# 总开关：关掉后不发邀请邮件（站内通知仍会发）
COMMUNICATION_INTERVIEW_MAIL_ENABLED=true
# 发件邮箱（全平台固定）：邀请邮件永远由这一个平台邮箱发出，与员工个人邮箱无关。
# 必须与 MAIL_USERNAME 一致，否则 QQ 会以「553 Mail from must equal authorized user」拒发。
COMMUNICATION_INTERVIEW_MAIL_FROM=2253695672@qq.com
# 发件人显示名（真实发件地址取 COMMUNICATION_INTERVIEW_MAIL_FROM）
COMMUNICATION_INTERVIEW_MAIL_FROM_NAME=多源异构岗位与能力图谱
# 平台入口地址（可选）：配置后会作为「前往平台处理」按钮写进邀请邮件正文
COMMUNICATION_INTERVIEW_MAIL_PLATFORM_URL=

# ============================================
# 自助注册（角色授权码）
# ============================================
# 授权码用于防止任意人自助注册成管理角色：除「员工」外，注册管理角色时必须填对。
# ⚠️ 必须自行改成自己的值；留空 = 该角色**不可**自助注册（这是有意的白名单语义）。
# ⚠️ 不要在代码/文档里写死这些值 —— 注册端点是未登录可访问的，泄漏即后门。
REGISTER_CODE_HR=HR-2026-KB
REGISTER_CODE_JOB_ARCHITECT=JA-2026-KB
REGISTER_CODE_PLATFORM_ADMIN=PA-2026-KB
# 仅本地联调：把验证码直接回传到响应里（没有邮件通道时用）。生产必须是 false。
REGISTER_CODE_EXPOSE=false

# ============================================
# ⚠️ Docker Compose 必填变量（缺任一则容器启动失败）
# ============================================
# 这 11 个变量被 docker-compose.yml 标记为必填（${VAR:?} 语法）。
# 自检命令：
#   grep -oP '\$\{\K[A-Z_]+(?=:\?)' docker-compose.yml | sort -u

# JWT 签名密钥：必须是足够长的随机串（建议 ≥32 字符），生产务必更换
JWT_SECRET=change-me-to-a-long-random-secret-string

# 允许的跨域来源（前端访问地址；多个用逗号分隔）
ALLOWED_ORIGINS=http://localhost,https://your-domain.com

# AI 模型部署密钥
AI_MODEL_DEPLOYMENT_KEY=your-ai-model-deployment-key

# SiliconFlow（文本/向量模型）API Key
SILICONFLOW_API_KEY=your-siliconflow-api-key

# 火山引擎 ASR（视频面试实时转写）API Key
VOLCENGINE_ASR_API_KEY=your-volcengine-asr-api-key

# MinIO（对象存储）访问凭据
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-secret
