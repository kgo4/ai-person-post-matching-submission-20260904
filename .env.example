# ============================================
# 环境变量模板 — 复制为 .env 后填入实际值
# cp .env.example .env
# ============================================

# MySQL
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_password_here
MYSQL_DATABASE=hrms_db
MYSQL_PORT=3306

# Redis
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# 前端端口
FRONTEND_PORT=80

# ===== 外部服务密钥 =====

# DeepSeek (AI 对话)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 对支持 thinking 参数的推理模型禁用隐藏推理输出，避免结构化响应为空。
# 仅在已验证提供商支持时设为 true。
AI_THINKING_DISABLED=false

# 阿里云 DashScope (向量嵌入)
DASHSCOPE_API_KEY=sk-your-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Milvus 向量数据库（自建 Standalone，随 docker-compose 启动）
# 容器内（backend）访问：http://milvus:19530
# 宿主机/本地 IDE 直连调试：http://localhost:19530
MILVUS_URI=http://milvus:19530
# 自建 Milvus 默认无鉴权，token 留空即可（仅 Zilliz Cloud 需要 token）
MILVUS_TOKEN=
# Milvus 默认数据库名是 default（Zilliz Cloud 上是实例内自定义的库名）
MILVUS_DATABASE=default
# 如需临时切回 Zilliz Cloud，改回下面三行：
# MILVUS_URI=https://your-instance.zilliz.com
# MILVUS_TOKEN=your-token-here
# MILVUS_DATABASE=your-database-name

# 火山引擎 Ark (视频多模态分析)
VOLCENGINE_ARK_API_KEY=your-key-here
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com

# 火山引擎语音服务
VOLCENGINE_SPEECH_APP_ID=your-app-id
VOLCENGINE_SPEECH_ACCESS_TOKEN=your-token

# 火山引擎实时对话
VOLCENGINE_REALTIME_ACCESS_KEY=your-access-key
VOLCENGINE_REALTIME_APP_KEY=your-app-key
