# ============================================
# AI人岗匹配系统 - 环境变量配置模板
# ============================================
# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# ============================================
# 数据库配置
# ============================================
# 主数据库（MySQL）
DB_URL=jdbc:mysql://localhost:3306/hrms_db?useUnicode=true&characterEncoding=UTF-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# PMS项目管理系统数据库（只读）
PMS_DB_URL=jdbc:mysql://your_pms_host:3306/pms?useUnicode=true&characterEncoding=UTF-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
PMS_DB_USERNAME=your_pms_username
PMS_DB_PASSWORD=your_pms_password_here

# ============================================
# AI服务配置
# ============================================
# DeepSeek Chat API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 阿里云千问 Embedding API
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2/embeddings

# 火山引擎 Ark API
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com
VOLCENGINE_ARK_API_KEY=your_volcengine_ark_api_key_here
VOLCENGINE_ARK_MODEL=doubao-seed-2-0-pro-260215

# 火山引擎 ASR（语音识别）
VOLCENGINE_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
VOLCENGINE_ASR_APP_ID=your_asr_app_id_here
VOLCENGINE_ASR_ACCESS_KEY=your_asr_access_key_here
VOLCENGINE_ASR_API_KEY=your_asr_api_key_here
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration

# ============================================
# 向量数据库配置
# ============================================
# Milvus (Zilliz Cloud)
MILVUS_URI=https://your_milvus_uri_here
MILVUS_TOKEN=your_milvus_token_here
MILVUS_DATABASE=your_milvus_database_here
MILVUS_COLLECTION=person_post_vector

# ============================================
# 图数据库配置
# ============================================
# Neo4j
NEO4J_ENABLED=true
NEO4J_URI=neo4j+s://your_neo4j_uri_here
NEO4J_USERNAME=your_neo4j_username_here
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=your_neo4j_database_here

# ============================================
# 消息队列配置
# ============================================
# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_LISTENER_AUTO_STARTUP=false

# ============================================
# 缓存配置
# ============================================
# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ============================================
# 安全配置
# ============================================
# JWT密钥（至少64字符随机字符串）
JWT_SECRET=your_jwt_secret_key_at_least_64_characters_long_random_string_here
JWT_EXPIRATION=86400000

# ============================================
# 知识库配置
# ============================================
# 火山引擎知识库
VOLCENGINE_KB_ENABLED=false
VOLCENGINE_KB_ENDPOINT=https://api-knowledgebase.mlp.cn-beijing.volces.com
VOLCENGINE_KB_REGION=cn-beijing
VOLCENGINE_KB_SERVICE=air
VOLCENGINE_KB_ACCESS_KEY=your_kb_access_key_here
VOLCENGINE_KB_SECRET_KEY=your_kb_secret_key_here
VOLCENGINE_KB_COLLECTION_NAME=your_kb_collection_name_here
VOLCENGINE_KB_PROJECT=default
VOLCENGINE_KB_RESOURCE_ID=your_kb_resource_id_here
VOLCENGINE_KB_PIPELINE_NAME=your_kb_pipeline_name_here
RAG_PROVIDER_MODE=hybrid
VOLCENGINE_KB_SYNC_MODE=point
VOLCENGINE_KB_DENSE_WEIGHT=0.5
VOLCENGINE_KB_RERANK=true
VOLCENGINE_KB_RERANK_MODEL=base-multilingual-rerank

# ============================================
# 部署配置
# ============================================
MATCHING_DEPLOYMENT_CODE=your_deployment_code_here
MATCHING_WEIGHT_PROFILE_PATH=

# 知乎外部趋势资源（仅岗位演化辅助，勿提交真实密钥）
ZHIHU_ENABLED=false
ZHIHU_API_BASE_URL=https://developer.zhihu.com
ZHIHU_ACCESS_SECRET=
ZHIHU_CONNECT_TIMEOUT_MILLIS=5000
ZHIHU_READ_TIMEOUT_MILLIS=15000

# ============================================
# LangChain4j Agent配置
# ============================================
LANGCHAIN4J_AGENTS_ENABLED=true
LANGCHAIN4J_BASE_URL=https://api.deepseek.com
LANGCHAIN4J_API_KEY=your_langchain4j_api_key_here
LANGCHAIN4J_MODEL_NAME=deepseek-flash
LANGCHAIN4J_TEMPERATURE=0.2
LANGCHAIN4J_TIMEOUT_SECONDS=60
LANGCHAIN4J_LOG_REQUESTS=false
LANGCHAIN4J_LOG_RESPONSES=false

# ============================================
# 面试配置
# ============================================
INTERVIEW_QUESTION_DURATION_EASY=30
INTERVIEW_QUESTION_DURATION_MEDIUM=60
INTERVIEW_QUESTION_DURATION_HARD=90

# ============================================
# 邮件配置（视频终面邀请通知）
# ============================================
# 走 QQ 邮箱 SMTP；留空则应用照常启动，邀请邮件被标记为「已跳过」，站内通知不受影响。
# ⚠️ MAIL_PASSWORD 是 QQ 邮箱后台生成的**授权码**（设置 → 账号与安全 → 授权码管理），
#    不是 QQ 登录密码；用户名/账户填 QQ 邮箱完整地址。
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
COMMUNICATION_INTERVIEW_MAIL_ENABLED=true
# 发件邮箱（全平台固定）：必须与 MAIL_USERNAME 一致，否则 QQ 会以 553 拒发
COMMUNICATION_INTERVIEW_MAIL_FROM=2253695672@qq.com
COMMUNICATION_INTERVIEW_MAIL_FROM_NAME=多源异构岗位与能力图谱
# 平台入口地址（可选）：配置后作为「前往平台处理」按钮写进邀请邮件正文
COMMUNICATION_INTERVIEW_MAIL_PLATFORM_URL=

# ============================================
# 自助注册（角色授权码）
# ============================================
# 授权码用于防止任意人自助注册成管理角色：除「员工」外，注册管理角色时必须填对。
# ⚠️ 必须自行改成自己的值；留空 = 该角色**不可**自助注册（这是有意的白名单语义）。
# ⚠️ 不要在代码/文档里写死这些值 —— 注册端点是未登录可访问的，泄漏即后门。
REGISTER_CODE_HR=HR-2026-KB
REGISTER_CODE_JOB_ARCHITECT=JA-2026-KB
REGISTER_CODE_PLATFORM_ADMIN=PA-2026-KB
# 仅本地联调：把验证码直接回传到响应里（没有邮件通道时用）。生产必须是 false。
REGISTER_CODE_EXPOSE=false
