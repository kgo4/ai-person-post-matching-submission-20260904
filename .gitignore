# ============================================
# Root .gitignore — AI Person-Post Matching
# ============================================

# ----- OS -----
.DS_Store
Thumbs.db
desktop.ini
nul

# ----- IDE -----
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# ----- Claude Code local settings -----
.claude/settings.local.json

# ----- Environment / Secrets -----
.env
.env.local
.env.*.local
certs/

# ----- Logs -----
logs/
*.log
hs_err_pid*.log
replay_pid*.log

# ----- Java / Maven -----
*.class
*.jar
*.war
*.ear
target/
backend/.m2/
backend/.mvn/

# ----- Node / Frontend -----
node_modules/
dist/
dist-ssr/
frontend/.env.local
frontend/.env.*.local

# ----- Uploads & Runtime Data -----
uploads/
runtime/

# ----- Database Dumps (keep .sql in docs/ only) -----
/hrms_db.sql
/pms.sql

# ----- Docs -----
# Keep deployment and operational runbooks versioned; ignore generated document artifacts.
docs/
!docs/
!docs/DEPLOYMENT_GUIDE.md
*.docx
*.pptx
*.xlsx
*.pdf

# ----- Docker volumes -----
docker-data/

# ----- Spring Boot -----
*.pid

# ----- Reasonix 工具运行时数据 -----
.reasonix/
reasonix.toml

# ----- 临时产物（API 冒烟测试、classpath dump、编译产物）-----
org/
backend/cp.txt
/package-lock.json

# ----- 部署临时包与发布快照（不应入库）-----
# 发布/部署用的打包产物体积可达数百 MB，且每次部署都会重新生成；
# 保留在本地即可，不要提交进版本库。
*.tgz
*.tar.gz
*.tar
release-staging-*/
release-*/

# ----- 本地临时工作目录 -----
tmp/
outputs/
.preview/
.tmp_pdf/
.tmp_review/
