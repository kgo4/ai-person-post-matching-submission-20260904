{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "node scripts/run-mjs-tests.js && vitest run",
    "test:unit": "node scripts/run-mjs-tests.js && vitest run",
    "test:ci": "node scripts/run-mjs-tests.js && vitest run --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml",
    "test:chart": "node --experimental-strip-types src/components/chart/chartVisibility.test.mjs && node --experimental-strip-types src/views/system/ability-tag/bubbleLabeling.test.mjs && node --experimental-strip-types src/views/system/ability-tag/tag-directory-panel.test.mjs",
    "test:mjs": "node scripts/run-mjs-tests.js",
    "lint": "vue-tsc --noEmit && eslint src --ext .ts,.vue --max-warnings 600",
    "lint:eslint": "eslint src --ext .ts,.vue --max-warnings 0",
    "lint:tsc":  "vue-tsc --noEmit",
    "lint:types":  "vue-tsc --noEmit"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/d3": "^7.4.3",
    "@types/dompurify": "^3.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/three": "^0.184.1",
    "axios": "^1.16.0",
    "d3": "^7.9.0",
    "dompurify": "^3.4.8",
    "echarts": "^6.0.0",
    "echarts-wordcloud": "^2.1.0",
    "element-plus": "^2.13.7",
    "markdown-it": "^14.2.0",
    "ogl": "^1.0.11",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "three": "^0.184.0",
    "vue": "^3.5.32",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@unocss/preset-icons": "^66.7.0",
    "@unocss/preset-uno": "^66.7.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "happy-dom": "^20.10.6",
    "sass-embedded": "^1.100.0",
    "typescript": "~6.0.2",
    "unocss": "^66.7.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.2.7"
  }
}
